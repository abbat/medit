<services>

  <!-- What OBS runs before it builds, so that a release is a git tag and
       nothing else. obs_scm fetches the repository and stores it as
       medit.obscpio beside medit.obsinfo; the three services after it are
       marked buildtime, which means they run in the build root rather than on
       the server, so the tarball is made when it is needed and is not kept
       twice.

       The version comes from the tag: versionformat takes the parent tag and
       the rewrite pattern drops the leading "v", so v1.3.5 becomes 1.3.5.
       There is no revision parameter on purpose. The trigger fires on the tag
       being pushed, when the default branch is that tag, and pinning the tag
       here would make this an eighth file to edit at every release.

       set_version writes that version into medit.spec and medit.dsc, so the
       two say the right thing even if a release forgot them. They are kept
       correct in git as well, which the version job checks. -->

  <service name="obs_scm">
    <param name="url">https://github.com/abbat/medit.git</param>
    <param name="scm">git</param>
    <param name="filename">medit</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="versionrewrite-pattern">v(.*)</param>
    <param name="versionrewrite-replacement">\1</param>
  </service>

  <service name="tar" mode="buildtime"/>

  <service name="recompress" mode="buildtime">
    <param name="file">*.tar</param>
    <param name="compression">bz2</param>
  </service>

  <service name="set_version" mode="buildtime"/>

</services>
