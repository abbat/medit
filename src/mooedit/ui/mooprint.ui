      <action-widget response="0">line_numbers</action-widget>
      <action-widget response="0">print_header</action-widget>
      <action-widget response="0">header_separator</action-widget>
      <action-widget response="0">print_footer</action-widget>
      <action-widget response="0">footer_separator</action-widget>
      <action-widget response="-6">cancelbutton1</action-widget>
      <action-widget response="-5">okbutton1</action-widget>
    </action-widgets>
  </object>
</interface>
