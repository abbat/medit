                            <property name="draw_indicator">True</property>
                          </object>
                          <packing>
                            <property name="expand">False</property>
                            <property name="fill">False</property>
                          </packing>
                        </child>
                        <child>
                          <object class="GtkGrid" id="table4">
                            <property name="visible">True</property>
                            <property name="column_spacing">12</property>
                            <property name="row_spacing">6</property>
                            <child>
                              <object class="GtkEntry" id="footer_right">
                                <property name="hexpand">True</property>
                                <property name="valign">center</property>
                                <property name="visible">True</property>
                                <property name="tooltip-text">Format is similar to that of strftime (3), with the following additions:
%Ef - printed document name;
%EF - full path of printed document;
%Ep - current page number;
%EP - total number of pages.</property>
                              </object>
                              <packing>
                                <property name="left_attach">1</property>
                                <property name="top_attach">2</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkEntry" id="footer_center">
                                <property name="hexpand">True</property>
                                <property name="valign">center</property>
                                <property name="visible">True</property>
                                <property name="tooltip-text">Format is similar to that of strftime (3), with the following additions:
%Ef - printed document name;
%EF - full path of printed document;
%Ep - current page number;
%EP - total number of pages.</property>
                              </object>
