# Maintainer: Anton Batenev <antonbatenev@yandex.ru>

pkgname=medit
pkgver=1.4.0
pkgrel=1
pkgdesc="Useful programming and around-programming text editor"
arch=(x86_64)
url="https://github.com/abbat/medit"
license=(LGPL-2.1-only)
depends=(glib2 gtk3 hicolor-icon-theme json-glib libx11 libxml2 vte3)
makedepends=(cmake gdk-pixbuf2 gettext glib2-devel intltool)
optdepends=('ctags: list the functions of the open document'
            'clang: clangd, the language server for C and C++'
            'gopls: the language server for Go'
            'python-lsp-server: the language server for Python')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('f44ceb65119a82f0c48cfb736a8a8ff64f7d410d42e8ee1159d2b76d2dea9342')

build() {
    # CMAKE_BUILD_TYPE=None keeps the flags makepkg exports; the install hook
    # is off because pacman updates the icon cache itself; ENABLE_STRICT so a
    # warning from those flags, or from a compiler newer than anything in CI,
    # fails the build rather than scrolling past
    cmake -S "$pkgname-$pkgver" -B build -Wno-dev \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DENABLE_INSTALL_HOOKS=OFF \
        -DENABLE_TERMINAL=ON \
        -DENABLE_LSP=ON \
        -DENABLE_STRICT=ON
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$pkgname-$pkgver/COPYING" -t "$pkgdir/usr/share/licenses/$pkgname"
}
