#. error message for wrong command line
#: ../src/medit-app/main.cpp:116
#, c-format
msgid "Invalid value '%s' for option %s"
msgstr "Неверное значение «%s» для параметра %s"

#. error message for wrong commmand line
#: ../src/medit-app/main.cpp:179
#, c-format
msgid "%s and %s options may not be used simultaneously\n"
msgstr "Параметры %s и %s не могут быть использованы одновременно\n"

#. help message for command line option --new-app
#: ../src/medit-app/main.cpp:204
msgid "Run new instance of application"
msgstr "Запустить новую копию приложения"

#. help message for command line option --use-session
#: ../src/medit-app/main.cpp:206
msgid "Load and save session"
msgstr "Загрузить и сохранить сеанс"

#. help message for command line option --pid=PID
#: ../src/medit-app/main.cpp:208
msgid "Use existing instance with process id PID"
msgstr ""
"Использовать существующую копию приложения с идентификатором процесса PID"

#. "PID" part in "--pid=PID"
#: ../src/medit-app/main.cpp:209
msgid "PID"
msgstr "PID"

#. help message for command line option --app-name=NAME
#: ../src/medit-app/main.cpp:211
msgid "Set instance name to NAME if it's not already running"
msgstr ""
"Установить имя копии приложения в NAME, если копия с таким именем ещё не "
"запущена"

#. "NAME" part in "--app-name=NAME"
#: ../src/medit-app/main.cpp:212
msgid "NAME"
msgstr "NAME"

#. help message for command line option --new-window
#: ../src/medit-app/main.cpp:214
msgid "Open file(s) in a new window"
msgstr "Открыть файл(ы) в новом окне"

